    (alloc.vec.Vec ids.ParserStateId))
  := do
  let vl ← normalized.ValidatedGrammar.impl.lalr self.grammar
  let (r, destination1) ←
    lalr.execute_terminals_concrete_into vl parser_stack emitted destination
  match r with
  | core.result.Result.Ok run =>
    match run with
    | lalr.RunDecision.Rejected =>
      ok (core.result.Result.Ok engine.TokenDecision.Rejected, destination1)
    | lalr.RunDecision.Continue =>
      let s ← lift (Array.to_slice (Array.make 1#usize [ eof ]))
      let (r1, destination2) ←
        lalr.execute_terminals_concrete_in_place vl destination1 s
      match r1 with
      | core.result.Result.Ok run1 =>
        match run1 with
        | lalr.RunDecision.Rejected =>
          ok (core.result.Result.Ok engine.TokenDecision.Rejected,
            destination2)
        | lalr.RunDecision.Continue =>
          ok (core.result.Result.Ok engine.TokenDecision.Rejected,
            destination2)
        | lalr.RunDecision.Accepted =>
          ok (core.result.Result.Ok engine.TokenDecision.Accepted,
            destination2)
        | lalr.RunDecision.Dependent =>
          ok (core.result.Result.Err engine.EngineError.CorruptPreparedData,
            destination2)
      | core.result.Result.Err error =>
        let ee ← engine.map_parser_error error
        ok (core.result.Result.Err ee, destination2)
    | lalr.RunDecision.Accepted =>
      ok (core.result.Result.Err engine.EngineError.CorruptPreparedData,
        destination1)
    | lalr.RunDecision.Dependent =>
      ok (core.result.Result.Err engine.EngineError.CorruptPreparedData,
        destination1)
  | core.result.Result.Err error =>
    let ee ← engine.map_parser_error error
    ok (core.result.Result.Err ee, destination1)

